# Not used by Docker. docker compose sets DATABASE_URL inside the API container.
# Copy to server/.env only if you run the API on the host (npm run dev:api).

PORT=3001
HOST=0.0.0.0
JWT_SECRET=propvault-dev-secret-change-in-production

# Host API talking to Docker Postgres is not the default path.
# Prefer: docker compose up --build
# DATABASE_URL=postgresql://propvault:propvault@localhost:5432/propvault
