# PostgreSQL superuser URL — required for npm run db:setup / db:setup-local
# (read automatically from this file; replace YOUR_PASSWORD with your postgres password)
PG_ADMIN_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres

# PostgreSQL connection (local install)
DATABASE_URL=postgresql://propvault:propvault@localhost:5432/propvault

# API port (bind 0.0.0.0 for intranet — LAN devices use http://<server-ip>:3001)
PORT=3001
HOST=0.0.0.0

# Local Electron offline database (separate from main)
LOCAL_DATABASE_URL=postgresql://propvault:propvault@localhost:5432/propvault_local

# Change in production
JWT_SECRET=propvault-dev-secret-change-in-production

# Optional SMTP fallback (IT Dashboard settings in DB take precedence when configured)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@rizal-palawan.gov.ph
